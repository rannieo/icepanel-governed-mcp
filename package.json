{
  "name": "icepanel-openapi-workflow",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "openapi:fetch": "bash scripts/openapi-fetch.sh",
    "openapi:split": "npx redocly split openapi/source/openapi.json --outDir openapi/src",
    "openapi:bundle": "bash scripts/openapi-build.sh bundle",
    "openapi:bundle:slim": "bash scripts/openapi-build.sh bundle-slim",
    "openapi:size": "bash scripts/openapi-size-report.sh",
    "openapi:build": "bash scripts/openapi-build.sh build",
    "mcp:start": "node --import tsx -e \"import('./src/server.ts').then((m)=>m.startServerCli())\"",
    "mcp:dev": "node --watch --import tsx --eval \"import('./src/server.ts').then((m)=>m.startServerCli())\"",
    "governance:validate": "node --import tsx -e \"import('./src/cli/validateGate.ts').then((m)=>m.startValidateGateCli(process.argv))\"",
    "governance:inspect": "node --import tsx -e \"import('./src/cli/inspectLedger.ts').then((m)=>m.startInspectLedgerCli(process.argv))\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "RUN_E2E=true vitest run --coverage.enabled=false test/mcp.e2e.test.ts",
    "test:e2e:write": "RUN_E2E=true E2E_ALLOW_WRITES=true vitest run --coverage.enabled=false test/mcp.e2e.test.ts"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  }
}
