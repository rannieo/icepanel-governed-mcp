      "minimum": 100,
      "type": "integer"
    },
    "pinIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tab": {
      "enum": [
        "tags",
        "technology",
        "status",
        "teams"
      ],
      "type": "string"
    },
    "theme": {
      "$ref": "./Theme.json"
    }
