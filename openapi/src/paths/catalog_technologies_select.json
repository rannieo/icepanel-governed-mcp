      },
      "404": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/Error.json"
            }
          }
        },
        "description": "Not Found"
      },
      "422": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/Error.json"
            }
          }
        },
        "description": "Unprocessable Entity"
      },
      "429": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/Error.json"
            }
          }
        },
        "description": "Resource Exhausted"
      },
      "500": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/Error.json"
            }
          }
        },
        "description": "Internal Server"
