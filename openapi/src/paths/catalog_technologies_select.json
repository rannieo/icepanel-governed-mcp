{
  "get": {
    "security": [
      {},
      {
        "ApiKeyAuth": []
      },
      {
        "BearerAuth": []
      }
    ],
    "tags": [
      "Catalog Technologies"
    ],
    "x-eov-operation-handler": "catalogTechnologies",
    "x-fern-sdk-group-name": [
      "catalog",
      "technologies"
    ],
    "description": "List technologies with selected fields",
    "operationId": "catalogTechnologiesListSelect",
    "parameters": [
      {
        "in": "query",
        "name": "filter",
        "required": false,
        "schema": {
          "$ref": "../components/schemas/CatalogTechnologyFilter.json"
        }
      },
      {
        "description": "list all technologies on the platform",
        "in": "query",
        "name": "admin",
        "schema": {
          "type": "boolean"
        },
        "x-fern-audiences": [
          "internal"
        ]
      },
      {
        "allowReserved": true,
        "in": "query",
        "name": "search",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "in": "query",
        "name": "cursor",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "description": "The maximum number of items to return, defaults to 1000",
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": {
          "maximum": 10000,
          "minimum": 1,
          "type": "number"
        }
      },
      {
        "in": "query",
        "name": "fields",
        "required": true,
        "schema": {
          "items": {
            "$ref": "../components/schemas/CatalogTechnologyField.json"
          },
          "type": "array"
        }
      }
    ],
